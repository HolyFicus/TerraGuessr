# Гибридный режим панорам:
# Если ключи не указаны, TerraSpotter автоматически использует бесплатные
# 360°-панорамы Panoramax (вообще без ключа и без карты) + бесплатные карты Leaflet.

# VITE_GOOGLE_MAPS_API_KEY: Опциональный ключ Google Maps JavaScript API
# (используется только Street View без google.maps.Map).
# В Google Cloud Console ограничьте ключ по HTTP Referrer (например: https://<логин>.github.io/*).
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_MAPILLARY_TOKEN: Опциональный бесплатный Client Token от Mapillary (MLY|...)
# Банковская карта не требуется; расширяет покрытие 360°-панорам по всему миру.
VITE_MAPILLARY_TOKEN=""

# VITE_BASE_PATH: По умолчанию "./" — работает на GitHub Pages (включая /repo-name/).
VITE_BASE_PATH="./"
